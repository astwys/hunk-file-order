{
  "name": "hunk-file-order",
  "version": "0.1.0",
  "description": "Choose the file order in Hunk reviews.",
  "keywords": [
    "hunk",
    "hunk-extension",
    "sorting",
    "file-ordering"
  ],
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "author": "Michael Bartl <astwys@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "hunk": {
    "apiVersion": 6,
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "dev": "hunk diff --extension .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "hunkdiff": "^0.19.0",
    "typescript": "^5.9.3"
  }
}
